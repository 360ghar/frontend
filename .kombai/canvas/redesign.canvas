      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #F8F9FB;\n    --surface: #FFFFFF;\n    --ink-primary: #111827;\n    --ink-secondary: #6B7280;\n    --accent-orange: #FF6B00;\n    --success: #16A34A;\n    --charcoal: #1F2937;\n    --whatsapp: #25D366;\n    --glass: rgba(255, 255, 255, 0.7);\n    --radius-lg: 24px;\n    --radius-xl: 28px;\n  }\n\n  body {\n    background-color: var(--bg-base);\n    color: var(--ink-primary);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n  }\n\n  .font-display { font-family: 'Space Grotesk', sans-serif; }\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  .glass-blur {\n    background: var(--glass);\n    backdrop-filter: blur(12px);\n    -webkit-backdrop-filter: blur(12px);\n  }\n\n  .shadow-soft {\n    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02);\n  }\n\n  .shadow-lift {\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n  }\n  .shadow-lift:hover {\n    transform: translateY(-8px);\n    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.08), 0 10px 10px -5px rgba(0,0,0,0.04);\n  }\n\n  .marquee-track {\n    display: flex;\n    width: max-content;\n    animation: marquee 40s linear infinite;\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .btn-magnetic {\n    transition: transform 0.2s cubic-bezier(0.33, 1, 0.68, 1);\n  }\n  .btn-magnetic:active { transform: scale(0.95); }\n</style>\n<div class=\"min-h-screen\" data-kid=\"1\">\n\n<nav class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-5xl px-4\" data-kid=\"1-1\">\n<div class=\"glass-blur shadow-soft rounded-full px-8 py-4 flex items-center justify-between border border-white/20\" data-kid=\"1-1-1\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1\">\n<div class=\"w-8 h-8 bg-(--accent-orange) rounded-lg flex items-center justify-center text-white\" data-kid=\"1-1-1-1-1\">\n<i class=\"ti ti-home-2 text-xl\" data-kid=\"1-1-1-1-1-1\"></i>\n</div>\n<span class=\"font-display font-bold text-xl tracking-tight\" data-kid=\"1-1-1-1-2\">360GHAR</span>\n</div>\n<div class=\"hidden md:flex items-center gap-8 text-sm font-medium\" data-kid=\"1-1-1-2\">\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-1-2-1\" href=\"#\">Buy</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-1-2-2\" href=\"#\">Rent</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-1-2-3\" href=\"#\">Sell</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-1-2-4\" href=\"#\">Localities</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-1-2-5\" href=\"#\">Data Hub</a>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n<button class=\"flex items-center gap-2 px-4 py-2 rounded-full bg-(--whatsapp)/10 text-(--whatsapp) font-semibold text-sm border border-(--whatsapp)/20\" data-kid=\"1-1-1-3-1\">\n<i class=\"ti ti-brand-whatsapp text-lg\" data-kid=\"1-1-1-3-1-1\"></i>\n<span data-kid=\"1-1-1-3-1-2\">Chat with RM</span>\n</button>\n<button class=\"px-6 py-2 rounded-full bg-(--ink-primary) text-white font-semibold text-sm hover:bg-black transition-colors\" data-kid=\"1-1-1-3-2\">\n          Sign In\n        </button>\n</div>\n</div>\n</nav>\n\n<section class=\"relative h-[95vh] flex items-center justify-center overflow-hidden\" data-kid=\"1-2\">\n<div class=\"absolute inset-0 z-0\" data-kid=\"1-2-1\">\n\n<img alt=\"Gurgaon high-rise residential towers at sunset by Ankur Khandelwal\" class=\"w-full h-full object-cover\" data-kid=\"1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1669429705226-bb2faacd8168?auto=format&amp;w=1600&amp;q=80&amp;fit=crop\">\n<div class=\"absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-(--bg-base)\" data-kid=\"1-2-1-2\"></div>\n</div>\n<div class=\"relative z-10 w-full max-w-4xl px-4 text-center\" data-kid=\"1-2-2\">\n<div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs font-medium mb-8\" data-kid=\"1-2-2-1\">\n<span class=\"w-2 h-2 rounded-full bg-(--accent-orange) animate-pulse\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"pulsing activity indicator\" data-reason=\"animates opacity via pulse keyframes\"></span>\n        INDIA'S VR-FIRST PROPTECH PLATFORM\n      </div>\n<h1 class=\"font-display text-5xl md:text-7xl font-bold text-white mb-8 tracking-tight leading-[1.1]\" data-kid=\"1-2-2-2\">\n        Find Your Dream Home in <span class=\"text-(--accent-orange)\" data-kid=\"1-2-2-2-1\">Gurugram</span>\n</h1>\n\n<div class=\"glass-blur p-2 rounded-[32px] shadow-2xl border border-white/30 flex items-center max-w-2xl mx-auto\" data-kid=\"1-2-2-3\">\n<div class=\"flex-1 px-6 flex items-center gap-4\" data-kid=\"1-2-2-3-1\">\n<i class=\"ti ti-sparkles text-(--accent-orange) text-xl\" data-kid=\"1-2-2-3-1-1\"></i>\n<input class=\"bg-transparent border-none outline-none w-full text-(--ink-primary) placeholder-(--ink-secondary) font-medium\" data-kid=\"1-2-2-3-1-2\" placeholder=\"AI Prompt: 'Luxury 3BHK in Sector 54 with pool view'...\" type=\"text\">\n</div>\n<button class=\"bg-(--accent-orange) text-white px-8 py-4 rounded-[28px] font-bold shadow-lg hover:brightness-110 transition-all flex items-center gap-2\" data-kid=\"1-2-2-3-2\">\n<span data-kid=\"1-2-2-3-2-1\">Search</span>\n<i class=\"ti ti-arrow-right\" data-kid=\"1-2-2-3-2-2\"></i>\n</button>\n</div>\n\n<div class=\"mt-12 flex flex-wrap justify-center gap-4\" data-kid=\"1-2-2-4\">\n<div class=\"glass-blur px-6 py-3 rounded-2xl border b