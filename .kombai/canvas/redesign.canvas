      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #F8F9FB;\n    --surface: #FFFFFF;\n    --ink-primary: #111827;\n    --ink-secondary: #6B7280;\n    --accent-orange: #FF6B00;\n    --success: #16A34A;\n    --charcoal: #1F2937;\n    --glass: rgba(255, 255, 255, 0.75);\n    --font-heading: 'Space Grotesk', sans-serif;\n    --font-body: 'Inter', sans-serif;\n    --radius-xl: 28px;\n    --radius-lg: 24px;\n    --shadow-premium: 0 20px 25px -5px rgba(0,0,0,0.08), 0 10px 10px -5px rgba(0,0,0,0.04);\n  }\n\n  body {\n    background-color: var(--bg-base);\n    color: var(--ink-primary);\n    font-family: var(--font-body);\n    margin: 0;\n    padding: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .font-body { font-family: var(--font-body); }\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n  }\n\n  .hero-video {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    z-index: -1;\n  }\n\n  .property-card:hover .card-img {\n    transform: scale(1.05);\n  }\n\n  .property-card:hover .explore-btn {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .animate-marquee {\n    display: flex;\n    width: 200%;\n    animation: marquee 40s linear infinite;\n  }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0px); }\n    50% { transform: translateY(-10px); }\n  }\n\n  .animate-float {\n    animation: float 6s ease-in-out infinite;\n  }\n</style>\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n\n<nav class=\"fixed top-0 left-0 w-full z-50 px-8 py-6\" data-kid=\"1-1\">\n<div class=\"max-w-7xl mx-auto flex items-center justify-between glass px-8 py-4 rounded-pill shadow-sm\" data-kid=\"1-1-1\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1\">\n<div class=\"w-8 h-8 bg-[var(--accent-orange)] rounded-lg flex items-center justify-center\" data-kid=\"1-1-1-1-1\">\n<i class=\"ti ti-home-2 text-white text-xl\" data-kid=\"1-1-1-1-1-1\"></i>\n</div>\n<span class=\"font-heading text-xl font-bold tracking-tight\" data-kid=\"1-1-1-1-2\">360GHAR</span>\n</div>\n<div class=\"hidden md:flex items-center gap-8 font-heading text-sm font-medium\" data-kid=\"1-1-1-2\">\n<a class=\"hover:text-[var(--accent-orange)] transition-colors\" data-kid=\"1-1-1-2-1\" href=\"#\">Properties</a>\n<a class=\"hover:text-[var(--accent-orange)] transition-colors\" data-kid=\"1-1-1-2-2\" href=\"#\">AI Search</a>\n<a class=\"hover:text-[var(--accent-orange)] transition-colors\" data-kid=\"1-1-1-2-3\" href=\"#\">VR Experience</a>\n<a class=\"hover:text-[var(--accent-orange)] transition-colors\" data-kid=\"1-1-1-2-4\" href=\"#\">Localities</a>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-1-3\">\n<button class=\"text-sm font-medium hover:text-[var(--accent-orange)] transition-colors\" data-kid=\"1-1-1-3-1\">Log In</button>\n<button class=\"bg-[var(--ink-primary)] text-white px-6 py-2.5 rounded-pill text-sm font-medium hover:bg-[var(--charcoal)] transition-all\" data-kid=\"1-1-1-3-2\">Get Started</button>\n</div>\n</div>\n</nav>\n\n<section class=\"relative h-[95vh] flex items-center justify-center overflow-hidden\" data-kid=\"1-2\">\n<video autoplay=\"\" class=\"hero-video\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"hero background video\" data-reason=\"video looped and autoplayed by browser\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/37694703/aerial-photography-drone-view-luxury-property-real-estate-aerial-37694703.jpeg?auto=compress&amp;cs=tinysrgb&amp;fit=crop&amp;h=630&amp;w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/37694703/15982837_360_640_30fps.mp4\"></video>\n<div class=\"absolute inset-0 bg-black/30\" data-kid=\"1-2-2\" data-name=\"hero background overlay\"></div>\n<div class=\"relative z-10 w-full max-w-4xl px-6 text-center\" data-kid=\"1-2-3\">\n<h1 class=\"font-heading text-6xl md:text-7xl font-bold text-white mb-8 reveal-up\" data-kid=\"1-2-3-1\">Find your home,<br data-kid=\"1-2-3-1-1\"><span class=\"text-[var(--accent-orange)]\" data-kid=\"1-2-3-1-2\">AI guided.</span></h1>\n<div class=\"glass p-2 rounded-[32px] shadow-2xl flex items-center gap-2 reveal-up\" data-kid=\"1-2-3-2\" style=\"animation-delay: 0.2s;\">\n<div class=\"flex-1 flex items-center gap-3 px-6 py-4\" data-kid=\"1-2-3-2-1\">\n<i class=\"ti ti-sparkles text-[var(--accent-orange)] text-2xl\" data-kid=\"1-2-3-2-1-1\"></i>\n<input class=\"w-full bg-transparent border-none outline-hidden text-lg font-body placeholder:text-gray-400\" data-kid=\"1-2-3-2-1-2\" placeholder=\"Describe your dream lifestyle...\" type=\"text\">\n</div>\n<button class=\"bg-[var(--accent-orange)] text-white px-10 py-5 rounded-[24px] font-heading font-bold text-lg hover:scale-105 transition-transform active:scale-95\" data-kid=\"1-2-3-2-2\">Search</button>\n</div>\n\n<div class=\"absolute -left-20 top-1/4 animate-float\" data-dynamic=\"true\" data-kid=\"1-2-3-3\" data-name=\"floating stats container\" data-reason=\"animated vertical position driven by script\" style=\"animation-delay: 1s;\">\n<div class=\"glass px-6 py-4 rounded-2xl shadow-xl flex items-center gap-3\" data-kid=\"1-2-3-3-1\">\n<div class=\"w-10 h-10 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400\" data-kid=\"1-2-3-3-1-1\">\n<i class=\"ti ti-home\" data-kid=\"1-2-3-3-1-1-1\"></i>\n</d