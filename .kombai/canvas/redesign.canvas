3-3-3\">\n<span class=\"text-sm font-medium text-(--ink-secondary)\" data-kid=\"1-5-1-2-3-3-3-1\">Lifestyle</span>\n<span class=\"text-sm font-bold text-(--ink-primary)\" data-kid=\"1-5-1-2-3-3-3-2\">8.5/10</span>\n</div>\n<div class=\"w-full bg-(--bg-base) h-1.5 rounded-full overflow-hidden\" data-kid=\"1-5-1-2-3-3-4\">\n<div class=\"bg-(--accent-orange) h-full w-[85%]\" data-kid=\"1-5-1-2-3-3-4-1\"></div>\n</div>\n</div>\n</div>\n\n<div class=\"md:col-span-8 bg-(--accent-orange) rounded-(--radius-xl) p-10 flex items-center justify-between text-white group cursor-pointer hover:brightness-110 transition-all overflow-hidden relative\" data-kid=\"1-5-1-2-4\">\n<div class=\"max-w-md relative z-10\" data-kid=\"1-5-1-2-4-1\">\n<h3 class=\"font-display text-3xl font-bold mb-4\" data-kid=\"1-5-1-2-4-1-1\">Compare Homes Side-by-Side</h3>\n<p class=\"text-white/80 leading-relaxed\" data-kid=\"1-5-1-2-4-1-2\">Stuck between two projects? Compare price, amenities, and RERA compliance data instantly.</p>\n<button class=\"mt-8 bg-white text-(--accent-orange) px-6 py-3 rounded-full font-bold flex items-center gap-2 group-hover:gap-4 transition-all\" data-kid=\"1-5-1-2-4-1-3\">\n<span data-kid=\"1-5-1-2-4-1-3-1\">Try Comparison Tool</span>\n<i class=\"ti ti-arrow-right\" data-kid=\"1-5-1-2-4-1-3-2\"></i>\n</button>\n</div>\n<div class=\"hidden lg:block w-64 h-48 bg-white/20 rounded-2xl border border-white/20 relative rotate-12 -mr-16\" data-kid=\"1-5-1-2-4-2\"></div>\n<i class=\"ti ti-layers-intersect absolute -right-8 bottom-0 text-[200px] text-black/5 pointer-events-none\" data-kid=\"1-5-1-2-4-3\"></i>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"py-24 px-4 bg-(--bg-base)\" data-kid=\"1-6\">\n<div class=\"max-w-7xl mx-auto glass-blur rounded-(--radius-xl) p-12 border border-white/50 shadow-soft flex flex-col md:flex-row items-center gap-16\" data-kid=\"1-6-1\">\n<div class=\"w-full md:w-1/2 relative\" data-kid=\"1-6-1-1\">\n<div class=\"aspect-[4/5] rounded-[32px] over