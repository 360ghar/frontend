      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #F8F9FB;\n    --surface: #FFFFFF;\n    --ink-primary: #111827;\n    --ink-secondary: #6B7280;\n    --accent-orange: #FF6B00;\n    --success: #16A34A;\n    --charcoal: #1F2937;\n    --glass: rgba(255, 255, 255, 0.7);\n    --radius-xl: 28px;\n    --radius-lg: 24px;\n  }\n\n  body {\n    background-color: var(--bg-base);\n    color: var(--ink-primary);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n  }\n\n  .font-display { font-family: 'Space Grotesk', sans-serif; }\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.3);\n  }\n\n  .shadow-soft {\n    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 10px 10px -5px rgba(0,0,0,0.02);\n  }\n\n  .magnetic-hover {\n    transition: transform 0.3s cubic-bezier(0.33, 1, 0.68, 1), box-shadow 0.3s ease;\n  }\n\n  .magnetic-hover:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 25px 30px -5px rgba(0,0,0,0.08);\n  }\n\n  /* Marquee animation */\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n  .animate-marquee {\n    display: flex;\n    width: 200%;\n    animation: marquee 30s linear infinite;\n  }\n\n  /* Floating animation */\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-10px); }\n  }\n  .animate-float {\n    animation: float 4s ease-in-out infinite;\n  }\n</style>\n<div class=\"min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n\n<nav class=\"fixed top-0 left-0 right-0 z-50 px-12 py-6 flex justify-between items-center bg-white/50 backdrop-blur-md border-b border-gray-100\" data-kid=\"1-1\" data-name=\"main navigation bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo and name container\">\n<div class=\"w-10 h-10 bg-(--accent-orange) rounded-xl flex items-center justify-center\" data-kid=\"1-1-1-1\" data-name=\"brand logo background\">\n<i class=\"ti ti-home-2 text-white text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"home icon\"></i>\n</div>\n<span class=\"font-display text-2xl font-bold tracking-tight\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">360Ghar</span>\n</div>\n<div class=\"flex items-center gap-8 text-sm font-medium text-(--ink-secondary)\" data-kid=\"1-1-2\" data-name=\"navigation link container\">\n<a class=\"hover:text-(--ink-primary) transition-colors\" data-kid=\"1-1-2-1\" data-name=\"buy link\" href=\"#\">Buy</a>\n<a class=\"hover:text-(--ink-primary) transition-colors\" data-kid=\"1-1-2-2\" data-name=\"rent link\" href=\"#\">Rent</a>\n<a class=\"hover:text-(--ink-primary) transition-colors\" data-kid=\"1-1-2-3\" data-name=\"sell link\" href=\"#\">Sell</a>\n<a class=\"hover:text-(--ink-primary) transition-colors\" data-kid=\"1-1-2-4\" data-name=\"localities link\" href=\"#\">Localities</a>\n<a class=\"hover:text-(--ink-primary) transition-colors\" data-kid=\"1-1-2-5\" data-name=\"data hub link\" href=\"#\">Data Hub</a>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-3\" data-name=\"authentication button container\">\n<button class=\"px-6 py-2.5 text-sm font-semibold hover:text-(--accent-orange) transition-colors\" data-kid=\"1-1-3-1\" data-name=\"log in button\">Log in</button>\n<button class=\"px-6 py-2.5 bg-(--ink-primary) text-white rounded-full text-sm font-semibold hover:bg-black transition-colors\" data-kid=\"1-1-3-2\" data-name=\"get started button\">Get Started</button>\n</div>\n</nav>\n\n<section class=\"relative h-[90vh] flex items-center justify-center overflow-hidden\" data-kid=\"1-2\" data-name=\"hero section with video background\">\n<video autoplay=\"\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-2-1\" data-name=\"hero video background\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/19120253/cars-drone-footage-drone-photography-drone-shot-19120253.jpeg?auto=compress&amp;cs=tinysrgb&amp;fit=crop&amp;h=630&amp;w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/19120253/19120253-uhd_3840_2160_50fps.mp4\"></video>\n<div class=\"absolute inset-0 bg-black/30\" data-kid=\"1-2-2\" data-name=\"video dark overlay\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-(--bg-base) via-transparent to-transparent\" data-kid=\"1-2-3\" data-name=\"video gradient bottom fade\"></div>\n<div class=\"relative z-10 text-center px-4 max-w-4xl\" data-kid=\"1-2-4\" data-name=\"hero content container\">\n<h1 class=\"font-display text-7xl font-bold text-white mb-8 tracking-tight\" data-kid=\"1-2-4-1\" data-name=\"hero main headline\">\n        India’s VR-First Way to <br data-kid=\"1-2-4-1-1\" data-name=\"headline line break\"> <span class=\"text-(--accent-orange)\" data-kid=\"1-2-4-1-2\" data-name=\"headline accent text\">Find a Home</span>\n</h1>\n\n<div class=\"glass max-w-2xl mx-auto rounded-full p-2 flex items-center shadow-2xl\" data-kid=\"1-2-4-2\" data-name=\"ai search bar container\">\n<div class=\"pl-6 pr-4 flex-1 flex items-center gap-3\" data-kid=\"1-2-4-2-1\" data-name=\"search input container\">\n<i class=\"ti ti-search text-gray-400\" data-kid=\"1-2-4-2-1-1\" data-name=\"search icon\"></i>\n<input class=\"bg-transparent border-none outline-none w-full text-sm font-medium placeholder:text-gray-500\" data-kid=\"1-2-4-2-1-2\" data-name=\"search input field\" placeholder=\"Describe your dream lifestyle (e.g. 3BHK with park view near Sector 57)\" type=\"text\">\n</div>\n<button class=\"bg-(--accent-orange) text-white h-12 px-8 rounded-full font-bold flex items-center gap-2 hover:scale-105 transition-transform\" data-kid=\"1-2-4-2-2\" data-name=\"ai match button\">\n<i class=\"ti ti-sparkles\" data-kid=\"1-2-4-2-2-1\" data-name=\"sparkles icon\"></i>\n          AI Match\n        </button>\n</div>\n\n<div class=\"mt-12 flex flex-wrap justify-center gap-4\" data-kid=\"1-2-4-3\" data-name=\"floating stats container\">\n<div class=\"glass animate-float px-6 py-3 rounded-full flex items-center gap-3 shadow-lg\" data-kid=\"1-2-4-3-1\" data-name=\"stat 1 card\" style=\"animation-delay: 0.2s;\">\n<i class=\"ti ti-home text-(--accent-orange)\" data-kid=\"1-2-4-3-1-1\" data-name=\"house icon\"></i>\n<span class=\"text-sm font-semibold\" data-kid=\"1-2-4-3-1-2\" data-name=\"stat 1 text\">50,000+ Properties</span>\n</div>\n<div class=\"glass animate-float px-6 py-3 rounded-full flex items-center gap-3 shadow-lg\" data-kid=\"1-2-4-3-2\" data-name=\"stat 2 card\" style=\"animation-delay: 0.5s;\">\n<i class=\"ti ti-brain text-(--accent-orange)\" data-kid=\"1-2-4-3-2-1\" data-name=\"brain icon\"></i>\n<span class=\"text-sm font-semibold\" data-kid=\"1-2-4-3-2-2\" data-name=\"stat 2 text\">AI Powered</span>\n</div>\n<div class=\"glass animate-float px-6 py-3 rounded-full flex items-center gap-3 shadow-lg\" data-kid=\"1-2-4-3-3\" data-name=\"stat 3 card\" style=\"animation-delay: 0.8s;\">\n<i class=\"ti ti-augmented-reality-2 text-(--accent-orange)\" data-kid=\"1-2-4-3-3-1\" data-name=\"augmented reality icon\"></i>\n<span class=\"text-sm font-semibold\" data-kid=\"1-2-4-3-3-2\" data-name=\"stat 3 text\">VR Tours</span>\n</div>\n<div class=\"glass animate-float px-6 py-3 rounded-full flex items-center gap-3 shadow-lg\" data-kid=\"1-2-4-3-4\" data-name=\"stat 4 card\" style=\"animation-delay: 1.1s;\">\n<i class=\"ti ti-users text-(--accent-orange)\" data-kid=\"1-2-4-3-4-1\" data-name=\"users icon\"></i>\n<span class=\"text-sm font-semibold\" data-kid=\"1-2-4-3-4-2\" data-name=\"stat 4 text\">Trusted by 10k+ Buyers</span>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"py-12 bg-white border-y border-gray-100 overflow-hidden\" data-kid=\"1-3\" data-name=\"trusted builders marquee section\">\n<div class=\"animate-marquee gap-24\" data-kid=\"1-3-1\" data-name=\"marquee animate container\">\n\n<div class=\"flex items-center gap-24 shrink-0\" data-kid=\"1-3-1-1\" data-name=\"marquee content list 1\">\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-1-1\" data-name=\"dlf label\">DLF PROPERTIES</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-1-2\" data-name=\"godrej label\">GODREJ PROPERTIES</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-1-3\" data-name=\"m3m label\">M3M GURUGRAM</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-1-4\" data-name=\"emaar label\">EMAAR INDIA</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-1-5\" data-name=\"tata housing label\">TATA HOUSING</span>\n</div>\n<div class=\"flex items-center gap-24 shrink-0\" data-kid=\"1-3-1-2\" data-name=\"marquee content list 2\">\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-2-1\" data-name=\"dlf label\">DLF PROPERTIES</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-2-2\" data-name=\"godrej label\">GODREJ PROPERTIES</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-2-3\" data-name=\"m3m label\">M3M GURUGRAM</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-2-4\" data-name=\"emaar label\">EMAAR INDIA</span>\n<span class=\"font-display text-xl font-bold text-gray-300 grayscale opacity-60\" data-kid=\"1-3-1-2-5\" data-name=\"tata housing label\">TATA HOUSING</span>\n</div>\n</div>\n</section>\n\n<section class=\"py-24 px-12 max-w-[1440px] mx-auto\" data-kid=\"1-4\" data-name=\"featured properties section\">\n<div class=\"flex justify-between items-end mb-12\" data-kid=\"1-4-1\" data-name=\"properties header container\">\n<div data-kid=\"1-4-1-1\" data-name=\"properties title container\">\n<h2 class=\"font-display text-4xl font-bold mb-4 tracking-tight\" data-kid=\"1-4-1-1-1\" data-name=\"properties main title\">Featured Properties</h2>\n<p class=\"text-(--ink-secondary) max-w-lg\" data-kid=\"1-4-1-1-2\" data-name=\"properties description\">Hand-picked premium listings in Gurgaon, verified by AI and available for one-click VR walkthroughs.</p>\n</div>\n<button class=\"font-semibold text-(--accent-orange) flex items-center gap-2 hover:gap-3 transition-all\" data-kid=\"1-4-1-2\" data-name=\"view all listings button\">\n        View All Listings <i class=\"ti ti-arrow-right\" data-kid=\"1-4-1-2-1\" data-name=\"arrow right icon\"></i>\n</button>\n</div>\n<div class=\"grid grid-cols-3 gap-8\" data-kid=\"1-4-2\" data-name=\"property cards grid\">\n\n<div class=\"group surface bg-white rounded-(--radius-xl) overflow-hidden shadow-soft cursor-pointer transition-all hover:scale-[1.02] hover:shadow-xl\" data-kid=\"1-4-2-1\" data-name=\"property card 1\">\n<div class=\"relative h-72 overflow-hidden\" data-kid=\"1-4-2-1-1\" data-name=\"card 1 image container\">\n<img alt=\"Modern architectural home exterior at twilight\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"1-4-2-1-1-1\" data-name=\"card 1 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n<div class=\"absolute top-4 left-4 glass px-3 py-1 rounded-full flex items-center gap-2\" data-kid=\"1-4-2-1-1-2\" data-name=\"card 1 status badge\">\n<i class=\"ti ti-circle-check-filled text-(--success) text-xs\" data-kid=\"1-4-2-1-1-2-1\" data-name=\"checkmark icon\"></i>\n<span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"1-4-2-1-1-2-2\" data-name=\"card 1 status text\">Builder Verified</span>\n</div>\n<div class=\"absolute top-4 right-4 bg-white/90 px-3 py-1 rounded-full text-(--success) text-xs font-bold shadow-sm\" data-kid=\"1-4-2-1-1-3\" data-name=\"card 1 ai match score\">\n            98% AI Match\n          </div>\n<div class=\"absolute bottom-4 right-4 w-10 h-10 bg-black/80 rounded-full flex items-center justify-center text-white\" data-kid=\"1-4-2-1-1-4\" data-name=\"card 1 vr icon container\">\n<i class=\"ti ti-view-360 text-lg\" data-kid=\"1-4-2-1-1-4-1\" data-name=\"vr icon\"></i>\n</div>\n\n<div class=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]\" data-kid=\"1-4-2-1-1-5\" data-name=\"card 1 hover overlay\">\n<button class=\"bg-white text-black px-6 py-3 rounded-full font-bold text-sm shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform\" data-kid=\"1-4-2-1-1-5-1\" data-name=\"explore vr button\">\n              Explore in VR\n            </button>\n</div>\n</div>\n<div class=\"p-6\" data-kid=\"1-4-2-1-2\" data-name=\"card 1 detail container\">\n<div class=\"flex justify-between items-start mb-2\" data-kid=\"1-4-2-1-2-1\" data-name=\"card 1 title and price\">\n<h3 class=\"font-display text-xl font-bold\" data-kid=\"1-4-2-1-2-1-1\" data-name=\"card 1 title\">The Sovereign Luxury</h3>\n<span class=\"text-lg font-bold text-(--ink-primary)\" data-kid=\"1-4-2-1-2-1-2\" data-name=\"card 1 price\">₹4.8 Cr</span>\n</div>\n<p class=\"text-sm text-(--ink-secondary) flex items-center gap-1\" data-kid=\"1-4-2-1-2-2\" data-name=\"card 1 location\">\n<i class=\"ti ti-map-pin\" data-kid=\"1-4-2-1-2-2-1\" data-name=\"location pin icon\"></i> DLF Phase 5, Gurugram\n          </p>\n<div class=\"mt-6 flex gap-4 pt-6 border-t border-gray-50 text-xs font-medium text-(--ink-secondary)\" data-kid=\"1-4-2-1-2-3\" data-name=\"card 1 specs container\">\n<span class=\"flex items-center gap-1\" data-kid=\"1-4-2-1-2-3-1\" data-name=\"card 1 bed count\"><i class=\"ti ti-bed\" data-kid=\"1-4-2-1-2-3-1-1\" data-name=\"bed icon\"></i> 4 Beds</span>\n<span class=\"flex items-center gap-1\" data-kid=\"1-4-2-1-2-3-2\" data-name=\"card 1 bath count\"><i class=\"ti ti-bath\" data-kid=\"1-4-2-1-2-3-2-1\" data-name=\"bath icon\"></i> 4 Baths</span>\n<span class=\"flex items-center gap-1\" data-kid=\"1-4-2-1-2-3-3\" data-name=\"card 1 area\"><i class=\"ti ti-maximize\" data-kid=\"1-4-2-1-2-3-3-1\" data-name=\"maximize icon\"></i> 3,450 sqft</span>\n</div>\n</div>\n</div>\n\n<div class=\"group surface bg-white rounded-(--radius-xl) overflow-hidden shadow-soft cursor-pointer transition-all hover:scale-[1.02] hover:shadow-xl\" data-kid=\"1-4-2-2\" data-name=\"property card 2\">\n<div class=\"relative h-72 overflow-hidden\" data-kid=\"1-4-2-2-1\" data-name=\"card 2 image container\">\n<img alt=\"Modern living room interior\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-110\" data-kid=\"1-4-2-2-1-1\" data-name=\"card 2 image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1724582586529-62622e50c0b3?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n<div class=\"absolute top-4 left-4 glass px-3 py-1 rounded-full flex items-center gap-2\" data-kid=\"1-4-2-2-1-2\" data-name=\"card 2 status badge\">\n<i class=\"ti ti-circle-check-filled text-(--success) text-xs\" data-kid=\"1-4-2-2-1-2-1\" data-name=\"checkmark icon\"></i>\n<span class=\"text-[10px] font-bold uppercase tracking-wider\" data-kid=\"1-4-2-2-1-2-2\" data-name=\"card 2 status text\">Builder Verified</span>\n</div>\n<div class=\"absolute top-4 right-4 bg-white/90 px-3 py-1 rounded-full text-(--success) text-xs font-bold shadow-sm\" data-kid=\"1-4-2-2-1-3\" data-name=\"card 2 ai match score\">\n            94% AI Match\n          </div>\n<div c