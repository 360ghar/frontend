      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-base: #F8F9FB;\n    --surface: #FFFFFF;\n    --ink-primary: #111827;\n    --ink-secondary: #6B7280;\n    --accent-orange: #FF6B00;\n    --success: #16A34A;\n    --charcoal: #1F2937;\n    --glass: rgba(255, 255, 255, 0.7);\n    --radius-xl: 28px;\n    --radius-lg: 24px;\n  }\n\n  body {\n    background-color: var(--bg-base);\n    color: var(--ink-primary);\n    font-family: 'Inter', sans-serif;\n    margin: 0;\n  }\n\n  .font-display { font-family: 'Space Grotesk', sans-serif; }\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  .glass {\n    background: var(--glass);\n    backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.4);\n  }\n\n  .shadow-premium {\n    box-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 10px 10px -5px rgba(0,0,0,0.02);\n  }\n\n  /* Floating WhatsApp Button */\n  .whatsapp-pill {\n    position: fixed;\n    bottom: 40px;\n    right: 40px;\n    background: #25D366;\n    color: white;\n    padding: 12px 24px;\n    border-radius: 9999px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-weight: 700;\n    font-size: 14px;\n    box-shadow: 0 10px 20px rgba(37, 211, 102, 0.3);\n    z-index: 100;\n    transition: transform 0.3s ease;\n  }\n  .whatsapp-pill:hover { transform: scale(1.05); }\n\n  /* Smooth Marquee */\n  @keyframes marquee {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n  .animate-marquee {\n    display: flex;\n    width: 200%;\n    animation: marquee 40s linear infinite;\n  }\n\n  /* Hover Reveal Overlay */\n  .property-overlay {\n    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);\n    opacity: 0;\n    transition: opacity 0.4s ease;\n  }\n  .group:hover .property-overlay { opacity: 1; }\n</style>\n<div class=\"min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n\n<a class=\"whatsapp-pill font-display\" data-kid=\"1-1\" data-name=\"floating whatsapp cta button\" href=\"#\">\n<i class=\"ti ti-brand-whatsapp text-xl\" data-kid=\"1-1-1\" data-name=\"whatsapp icon\"></i>\n    Chat with Relationship Manager\n  </a>\n\n<nav class=\"fixed top-0 left-0 right-0 z-50 px-12 py-6 flex justify-between items-center bg-white/60 backdrop-blur-xl border-b border-gray-100\" data-kid=\"1-2\" data-name=\"site header navigation\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-1\" data-name=\"logo container\">\n<div class=\"w-10 h-10 bg-(--accent-orange) rounded-xl flex items-center justify-center shadow-lg shadow-orange-200\" data-kid=\"1-2-1-1\" data-name=\"logo icon container\">\n<i class=\"ti ti-home-2 text-white text-xl\" data-kid=\"1-2-1-1-1\" data-name=\"home icon\"></i>\n</div>\n<span class=\"font-display text-2xl font-bold tracking-tight\" data-kid=\"1-2-1-2\" data-name=\"brand name text\">360Ghar</span>\n</div>\n<div class=\"flex items-center gap-10 text-sm font-semibold text-(--ink-secondary)\" data-kid=\"1-2-2\" data-name=\"navigation menu links\">\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-2-1\" data-name=\"buy nav link\" href=\"#\">Buy</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-2-2\" data-name=\"rent nav link\" href=\"#\">Rent</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-2-3\" data-name=\"plot inventory nav link\" href=\"#\">Plot Inventory</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-2-4\" data-name=\"gurgaon localities nav link\" href=\"#\">Gurgaon Localities</a>\n<a class=\"hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-2-5\" data-name=\"circle rates nav link\" href=\"#\">Circle Rates</a>\n</div>\n<div class=\"flex items-center gap-4\" data-kid=\"1-2-3\" data-name=\"header action buttons container\">\n<button class=\"px-6 py-2.5 text-sm font-bold hover:text-(--accent-orange) transition-colors\" data-kid=\"1-2-3-1\" data-name=\"partner with us button\">Partner with Us</button>\n<button class=\"px-8 py-2.5 bg-(--ink-primary) text-white rounded-full text-sm font-bold shadow-xl shadow-gray-200 hover:bg-black transition-all active:scale-95\" data-kid=\"1-2-3-2\" data-name=\"login register button\">Login / Register</button>\n</div>\n</nav>\n\n<section class=\"relative h-[95vh] flex items-center justify-center overflow-hidden\" data-kid=\"1-3\" data-name=\"hero section\">\n\n<img alt=\"Gurgaon city skyline at sunset\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-3-1\" data-name=\"hero background image\" src=\"https://images.unsplash.com/photo-1715870251864-64fd4a6ae4ad?auto=format&amp;w=1600&amp;q=80&amp;fit=crop\">\n<div class=\"absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-(--bg-base)\" data-kid=\"1-3-2\" data-name=\"hero gradient overlay\"></div>\n<div class=\"relative z-10 text-center px-4 max-w-5xl\" data-kid=\"1-3-3\" data-name=\"hero content container\">\n<div class=\"inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20 mb-8\" data-kid=\"1-3-3-1\" data-name=\"ai platform badge\">\n<span class=\"w-2 h-2 rounded-full bg-(--accent-orange) animate-pulse\" data-kid=\"1-3-3-1-1\" data-name=\"pulsing indicator\"></span>\n<span class=\"text-white text-xs font-bold uppercase tracking-widest\" data-kid=\"1-3-3-1-2\" data-name=\"platform badge text\">India's First AI + VR Platform</span>\n</div>\n<h1 class=\"font-display text-8xl font-bold text-white mb-10 tracking-tight leading-[0.95]\" data-kid=\"1-3-3-2\" data-name=\"hero headline\">\n        The Smartest Way to <br data-kid=\"1-3-3-2-1\" data-name=\"headline line break\"> <span class=\"text-(--accent-orange)\" data-kid=\"1-3-3-2-2\" data-name=\"highlighted headline text\">Find Your Ghar.</span>\n</h1>\n\n<div class=\"glass max-w-2xl mx-auto rounded-full p-2 flex items-center shadow-2xl transition-all hover:scale-[1.01]\" data-kid=\"1-3-3-3\" data-name=\"ai search bar\">\n<div class=\"pl-8 pr-4 flex-1 flex items-center gap-4\" data-kid=\"1-3-3-3-1\" data-name=\"search input container\">\n<i class=\"ti ti-sparkles text-(--accent-orange) text-xl\" data-kid=\"1-3-3-3-1-1\" data-name=\"sparkles icon\"></i>\n<input class=\"bg-transparent border-none outline-none w-full text-sm font-semibold placeholder:text-gray-400 text-(--ink-primary)\" data-kid=\"1-3-3-3-1-2\" data-name=\"search input field\" placeholder=\"Describe your life... e.g. 3BHK for a growing family near Huda City Metro\" type=\"text\">\n</div>\n<button class=\"bg-(--accent-orange) text-white h-14 px-10 rounded-full font-bold flex items-center gap-2 shadow-xl shadow-orange-200 hover:shadow-orange-300 transition-all\" data-kid=\"1-3-3-3-2\" data-name=\"generate matches button\">\n          Generate Matches\n        </button>\n</div>\n\n<div class=\"mt-16 flex flex-wrap justify-center gap-4\" data-kid=\"1-3-3-4\" data-name=\"hero features stats container\">\n<div class=\"glass px-6 py-3.5 rounded-full flex items-center gap-3 shadow-xl\" data-kid=\"1-3-3-4-1\" data-name=\"rera registered feature\">\n<i class=\"ti ti-certificate-2 text-(--accent-orange) text-lg\" data-kid=\"1-3-3-4-1-1\" data-name=\"certificate icon\"></i>\n<span class=\"text-xs font-bold uppercase tracking-wide\" data-kid=\"1-3-3-4-1-2\" data-name=\"rera feature text\">100% RERA Registered</span>\n</div>\n<div class=\"glass px-6 py-3.5 rounded-full flex items-center gap-3 shadow-xl\" data-kid=\"1-3-3-4-2\" data-name=\"verified location feature\">\n<i class=\"ti ti-map-2 text-(--accent-orange) text-lg\" data-kid=\"1-3-3-4-2-1\" data-name=\"map pin icon\"></i>\n<span class=\"text-xs font-bold uppercase tracking-wide\" data-kid=\"1-3-3-4-2-2\" data-name=\"verified location feature 