      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@300;400;600&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    font-family: 'Manrope', sans-serif;\n    background-color: #ffffff;\n    color: #181616;\n    margin: 0;\n  }\n\n  .font-serif { font-family: 'Playfair Display', serif; }\n  .font-mono { font-family: 'Space Mono', monospace; }\n  .text-accent { color: #ff6b00; }\n  .bg-accent { background-color: #ff6b00; }\n  .border-accent { border-color: #ff6b00; }\n</style>\n<div class=\"min-h-screen\" data-kid=\"1\" data-name=\"page layout container\">\n\n<header class=\"flex justify-between items-center px-12 py-8 border-b border-gray-100\" data-kid=\"1-1\" data-name=\"main header section\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1\" data-name=\"brand logo container\">\n<div class=\"w-10 h-10 flex items-center justify-center border border-black\" data-kid=\"1-1-1-1\" data-name=\"home icon container\">\n<i class=\"ti ti-home-2 text-xl\" data-kid=\"1-1-1-1-1\" data-name=\"home icon\"></i>\n</div>\n<span class=\"text-xl font-bold tracking-tighter uppercase\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">360Ghar</span>\n</div>\n<nav class=\"flex items-center gap-8\" data-kid=\"1-1-2\" data-name=\"navigation menu container\">\n<button class=\"font-mono text-xs uppercase tracking-widest hover:text-accent transition-colors\" data-kid=\"1-1-2-1\" data-name=\"menu trigger button\">Menu</button>\n<i class=\"ti ti-menu-2 text-2xl cursor-pointer\" data-kid=\"1-1-2-2\" data-name=\"menu hamburger icon\"></i>\n</nav>\n</header>\n\n<section class=\"grid grid-cols-1 lg:grid-cols-2 min-h-[90vh]\" data-kid=\"1-2\" data-name=\"hero section\">\n\n<div class=\"flex flex-col justify-center px-12 lg:px-24 py-20 bg-white\" data-kid=\"1-2-1\" data-name=\"hero content column\">\n<div class=\"mb-6\" data-kid=\"1-2-1-1\" data-name=\"category tag container\">\n<span class=\"font-mono text-xs uppercase tracking-[0.3em] text-accent\" data-kid=\"1-2-1-1-1\" data-name=\"category tag text\">Gurugram's VR Platform</span>\n</div>\n<h1 class=\"font-serif text-6xl lg:text-8xl font-bold leading-[1.05] mb-8\" data-kid=\"1-2-1-2\" data-name=\"hero headline text\">\n        India's <span class=\"italic font-normal\" data-kid=\"1-2-1-2-1\" data-name=\"highlighted text\">VR-First</span> Way to Find a Home\n      </h1>\n<p class=\"text-xl text-gray-500 max-w-lg mb-12 leading-relaxed font-light\" data-kid=\"1-2-1-3\" data-name=\"hero subheadline description text\">\n        Eliminating fake listings through studio-quality 360° guided walkthroughs and physically inspected properties.\n      </p>\n\n<div class=\"max-w-md\" data-kid=\"1-2-1-4\" data-name=\"search component container\">\n<div class=\"flex gap-8 mb-4 border-b border-gray-100 pb-2\" data-kid=\"1-2-1-4-1\" data-name=\"search mode tab container\">\n<button class=\"font-mono text-xs uppercase tracking-widest text-accent border-b border-accent pb-2\" data-kid=\"1-2-1-4-1-1\" data-name=\"rent mode tab button\">Rent</button>\n<button class=\"font-mono text-xs uppercase tracking-widest text-gray-400 hover:text-black transition-colors pb-2\" data-kid=\"1-2-1-4-1-2\" data-name=\"buy mode tab button\">Buy</button>\n<button class=\"font-mono text-xs uppercase tracking-widest text-gray-400 hover:text-black transition-colors pb-2\" data-kid=\"1-2-1-4-1-3\" data-name=\"sell mode tab button\">Sell</button>\n</div>\n<div class=\"relative group\" data-kid=\"1-2-1-4-2\" data-name=\"search input container\">\n<input class=\"w-full py-6 text-2xl font-serif border-b border-black focus:outline-none focus:border-accent transition-colors bg-transparent placeholder:text-gray-200\" data-kid=\"1-2-1-4-2-1\" data-name=\"search input field\" placeholder=\"Search any location...\" type=\"text\">\n<button class=\"absolute right-0 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center hover:text-accent transition-colors\" data-kid=\"1-2-1-4-2-2\" data-name=\"search submit button\">\n<i class=\"ti ti-arrow-right text-2xl\" data-kid=\"1-2-1-4-2-2-1\" data-name=\"right arrow icon\"></i>\n</button>\n</div>\n</div>\n</div>\n\n<div class=\"relative overflow-hidden\" data-kid=\"1-2-2\" data-name=\"hero visual image container\">\n<img alt=\"Modern high-rise residential building with bright sky background. Photo by Ra Dragon on Unsplash\" class=\"absolute inset-0 w-full h-full object-cover\" data-kid=\"1-2-2-1\" data-name=\"hero featured property image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1567175125294-070a706511c4?auto=format&amp;w=1280&amp;q=80&amp;fit=crop\">\n\n<div class=\"absolute bottom-12 left-12 bg-white/10 backdrop-blur-md p-6 text-white border border-white/20\" data-kid=\"1-2-2-2\" data-name=\"featured project overlay tag\">\n<div class=\"font-mono text-xs uppercase tracking-widest mb-1 opacity-60\" data-kid=\"1-2-2-2-1\" data-name=\"featured project label text\">Featured Project</div>\n<div class=\"font-serif text-2xl\" data-kid=\"1-2-2-2-2\" data-name=\"featured project title text\">The Emerald Residences</div>\n</div>\n</div>\n</section>\n\n<div class=\"px-12\" data-kid=\"1-3\" data-name=\"divider rule section\">\n<div class=\"h-px w-full bg-accent opacity-30\" data-kid=\"1-3-1\" data-name=\"divider horizontal line\"></div>\n</div>\n\n<section class=\"px-12 py-24\" data-kid=\"1-4\" data-name=\"features index section\">\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 divide-x divide-gray-100 border-x border-gray-100\" data-kid=\"1-4-1\" data-name=\"features grid container\">\n\n<div class=\"p-12 group hover:bg-gray-50 transition-colors\" data-kid=\"1-4-1-1\" data-name=\"feature item 01\">\n<div class=\"font-mono text-accent text-sm mb-12\" data-kid=\"1-4-1-1-1\" data-name=\"feature 01 index text\">01 /</div>\n<h3 class=\"font-serif text-2xl mb-4 group-hover:text-accent transition-colors\" data-kid=\"1-4-1-1-2\" data-name=\"feature 01 title text\">AI-Enabled Virtual Tours</h3>\n<p class=\"text-gray-500 font-light leading-relaxed\" data-kid=\"1-4-1-1-3\" data-name=\"feature 01 description text\">Studio-quality 360° guided walkthroughs for every property.</p>\n</div>\n\n<div class=\"p-12 group hover:bg-gray-50 transition-colors\" data-kid=\"1-4-1-2\" data-name=\"feature item 02\">\n<div class=\"font-mono text-accent text-sm mb-12\" data-kid=\"1-4-1-2-1\" data-name=\"feature 02 index text\">02 /</div>\n<h3 class=\"font-serif text-2xl mb-4 group-hover:text-accent transition-colors\" data-kid=\"1-4-1-2-2\" data-name=\"feature 02 title text\">Dedicated Manager</h3>\n<p class=\"text-gray-500 font-light leading-relaxed\" data-kid=\"1-4-1-2-3\" data-name=\"feature 02 description text\">A personal Relationship Manager for end-to-end property search.</p>\n</div>\n\n<div class=\"p-12 group hover:bg-gray-50 transition-colors\" data-kid=\"1-4-1-3\" data-name=\"feature item 03\">\n<div class=\"font-mono text-accent text-sm mb-12\" data-kid=\"1-4-1-3-1\" data-name=\"feature 03 index text\">03 /</div>\n<h3 class=\"font-serif text-2xl mb-4 group-hover:text-accent transition-colors\" data-kid=\"1-4-1-3-2\" data-name=\"feature 03 title text\">Total Transparency</h3>\n<p class=\"text-gray-500 font-light leading-relaxed\" data-kid=\"1-4-1-3-3\" data-name=\"feature 03 description text\">Verified details and exact locations with zero upfront fees.</p>\n</div>\n\n<div class=\"p-12 group hover:bg-gray-50 transition-colors\" data-kid=\"1-4-1-4\" data-name=\"feature item 04\">\n<div class=\"font-mono text-accent text-sm mb-12\" data-kid=\"1-4-1-4-1\" data-name=\"feature 04 index text\">04 /</div>\n<h3 class=\"font-serif text-2xl mb-4 group-hover:text-accent transition-colors\" data-kid=\"1-4-1-4-2\" data-name=\"feature 04 title text\">Owner Onboarding</h3>\n<p class=\"text-gray-500 font-light leading-relaxed\" data-kid=\"1-4-1-4-3\" data-name=\"feature 04 description text\">Free professional photography and media capture for your listing.</p>\n</div>\n</div>\n</section>\n\n<section class=\"px-12 py-24 bg-gray-50\" data-kid=\"1-5\" data-name=\"properties gallery section\">\n<div class=\"flex justify-between items-end mb-16\" data-kid=\"1-5-1\" data-name=\"gallery header container\">\n<div class=\"max-w-xl\" data-kid=\"1-5-1-1\" data-name=\"gallery title group\">\n<span class=\"font-mono text-xs uppercase tracking-[0.3em] text-accent mb-4 block\" data-kid=\"1-5-1-1-1\" data-name=\"gallery subtitle label\">Curated Listings</span>\n<h2 class=\"font-serif text-5xl font-semibold\" data-kid=\"1-5-1-1-2\" data-name=\"gallery main title\">Investing in real estate made effortless</h2>\n</div>\n<button class=\"px-8 py-4 border border-black font-mono text-xs uppercase tracking-widest hover:bg-black hover:text-white transition-all\" data-kid=\"1-5-1-2\" data-name=\"view directory button\">View Directory</button>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12\" data-kid=\"1-5-2\" data-name=\"property items grid container\">\n\n<div class=\"flex flex-col gap-6\" data-kid=\"1-5-2-1\" data-name=\"property item 01 card\">\n<div class=\"aspect-[4/5] overflow-hidden bg-gray-200\" data-kid=\"1-5-2-1-1\" data-name=\"property 01 image wrapper\">\n<img alt=\"Modern living room with smart home features. Photo by Roberto Nickson on Unsplash\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-5-2-1-1-1\" data-name=\"property 01 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1564078516393-cf04bd966897?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n</div>\n<div class=\"flex justify-between items-start\" data-kid=\"1-5-2-1-2\" data-name=\"property 01 details container\">\n<div data-kid=\"1-5-2-1-2-1\" data-name=\"property 01 basic info container\">\n<h4 class=\"font-serif text-2xl mb-1\" data-kid=\"1-5-2-1-2-1-1\" data-name=\"property 01 name title\">Sector 57 Sky Villa</h4>\n<p class=\"font-mono text-xs text-gray-400\" data-kid=\"1-5-2-1-2-1-2\" data-name=\"property 01 specs label\">3BHK • 2450 SQ.FT</p>\n</div>\n<div class=\"font-serif text-xl text-accent\" data-kid=\"1-5-2-1-2-2\" data-name=\"property 01 price text\">₹2.4 Cr</div>\n</div>\n</div>\n\n<div class=\"flex flex-col gap-6 lg:mt-24\" data-kid=\"1-5-2-2\" data-name=\"property item 02 card\">\n<div class=\"aspect-[4/5] overflow-hidden bg-gray-200\" data-kid=\"1-5-2-2-1\" data-name=\"property 02 image wrapper\">\n<img alt=\"Minimalist stark white interior. Photo by Inside Weather on Unsplash\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-5-2-2-1-1\" data-name=\"property 02 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1567016376408-0226e4d0c1ea?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n</div>\n<div class=\"flex justify-between items-start\" data-kid=\"1-5-2-2-2\" data-name=\"property 02 details container\">\n<div data-kid=\"1-5-2-2-2-1\" data-name=\"property 02 basic info container\">\n<h4 class=\"font-serif text-2xl mb-1\" data-kid=\"1-5-2-2-2-1-1\" data-name=\"property 02 name title\">DLF Phase 4 Duplex</h4>\n<p class=\"font-mono text-xs text-gray-400\" data-kid=\"1-5-2-2-2-1-2\" data-name=\"property 02 specs label\">4BHK • 3200 SQ.FT</p>\n</div>\n<div class=\"font-serif text-xl text-accent\" data-kid=\"1-5-2-2-2-2\" data-name=\"property 02 price text\">₹4.8 Cr</div>\n</div>\n</div>\n\n<div class=\"flex flex-col gap-6\" data-kid=\"1-5-2-3\" data-name=\"property item 03 card\">\n<div class=\"aspect-[4/5] overflow-hidden bg-gray-200\" data-kid=\"1-5-2-3-1\" data-name=\"property 03 image wrapper\">\n<img alt=\"Modern kitchen with marble countertops. Photo by Simona Sergi on Unsplash\" class=\"w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700\" data-kid=\"1-5-2-3-1-1\" data-name=\"property 03 thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1610276099118-c929abaaa80a?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n</div>\n<div class=\"flex justify-between items-start\" data-kid=\"1-5-2-3-2\" data-name=\"property 03 details container\">\n<div data-kid=\"1-5-2-3-2-1\" data-name=\"property 03 basic info container\">\n<h4 class=\"font-serif text-2xl mb-1\" data-kid=\"1-5-2-3-2-1-1\" data-name=\"property 03 name title\">M3M Golf Estate Loft</h4>\n<p class=\"font-mono text-xs text-gray-400\" data-kid=\"1-5-2-3-2-1-2\" data-name=\"property 03 specs label\">2BHK • 1850 SQ.FT</p>\n</div>\n<div class=\"font-serif text-xl text-accent\" data-kid=\"1-5-2-3-2-2\" data-name=\"property 03 price text\">₹1.9 Cr</div>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"px-12 py-32 bg-white flex flex-col lg:flex-row gap-24 items-center\" data-kid=\"1-6\" data-name=\"testimonials section\">\n<div class=\"lg:w-1/4 border-l border-accent pl-12\" data-kid=\"1-6-1\" data-name=\"testimonial sidebar container\">\n<h3 class=\"font-mono text-xs uppercase tracking-widest text-accent mb-8\" data-kid=\"1-6-1-1\" data-name=\"testimonial section label\">Trusted Voices</h3>\n<ul class=\"flex flex-col gap-6 font-serif text-lg text-gray-400\" data-kid=\"1-6-1-2\" data-name=\"testimonial user navigation list\">\n<li class=\"text-black border-b border-black w-fit\" data-kid=\"1-6-1-2-1\" data-name=\"testimonial user item active\">Rahul S. / Buyer</li>\n<li class=\"hover:text-black cursor-pointer transition-colors\" data-kid=\"1-6-1-2-2\" data-name=\"testimonial user item link 01\">Priya M. / Seller</li>\n<li class=\"hover:text-black cursor-pointer transition-colors\" data-kid=\"1-6-1-2-3\" data-name=\"testimonial user item link 02\">Vikram T. / Landlord</li>\n<li class=\"hover:text-black cursor-pointer transition-colors\" data-kid=\"1-6-1-2-4\" data-name=\"testimonial user item link 03\">Amit K. / Tenant</li>\n</ul>\n</div>\n<div class=\"lg:w-3/4 relative\" data-kid=\"1-6-2\" data-name=\"testimonial quote content container\">\n<span class=\"absolute -top-16 -left-8 font-serif text-[180px] text-accent opacity-10\" data-kid=\"1-6-2-1\" data-name=\"decorative quote mark\">“</span>\n<blockquote class=\"font-serif text-4xl lg:text-5xl leading-tight max-w-4xl relative z-10\" data-kid=\"1-6-2-2\" data-name=\"testimonial quote text\">\n        Excellent VR tours helped me shortlist properties without visiting 10 sites. My RM handled everything from visits to final registration with zero stress.\n      </blockquote>\n<div class=\"mt-12 flex items-center gap-4\" data-kid=\"1-6-2-3\" data-name=\"testimonial author attribution container\">\n<div class=\"h-px w-12 bg-accent\" data-kid=\"1-6-2-3-1\" data-name=\"attribution underline decoration\"></div>\n<span class=\"font-mono text-xs uppercase tracking-widest\" data-kid=\"1-6-2-3-2\" data-name=\"testimonial author name text\">Rahul S. — Gurugram</span>\n</div>\n</div>\n</section>\n\n<footer class=\"bg-black text-white px-12 pt-32 pb-12\" data-kid=\"1-7\" data-name=\"footer section\">\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-24 mb-32 pb-32 border-b border-white/10\" data-kid=\"1-7-1\" data-name=\"footer content grid\">\n<div data-kid=\"1-7-1-1\" data-name=\"referral call-to-action column\">\n<span class=\"font-mono text-xs uppercase tracking-widest text-accent mb-6 block\" data-kid=\"1-7-1-1-1\" data-name=\"referral program label\">Referral Program</span>\n<h2 class=\"font-serif text-5xl mb-8\" data-kid=\"1-7-1-1-2\" data-name=\"referral heading\">Know someone selling or renting?</h2>\n<p class=\"text-xl text-gray-400 font-light max-w-md mb-12\" data-kid=\"1-7-1-1-3\" data-name=\"referral description text\">Refer a property owner and earn ₹100 upon listing and up to ₹10,000 when the deal completes.</p>\n<button class=\"bg-accent text-white px-12 py-5 font-mono text-xs uppercase tracking-widest hover:bg-white hover:text-black transition-all\" data-kid=\"1-7-1-1-4\" data-name=\"start referring button\">Start Referring</button>\n</div>\n<div class=\"flex flex-col justify-end\" data-kid=\"1-7-1-2\" data-name=\"footer links navigation column\">\n<div class=\"grid grid-cols-2 gap-12\" data-kid=\"1-7-1-2-1\" data-name=\"footer links sub-grid\">\n<div data-kid=\"1-7-1-2-1-1\" data-name=\"directory column\">\n<h5 class=\"font-mono text-xs uppercase tracking-widest text-gray-500 mb-6\" data-kid=\"1-7-1-2-1-1-1\" data-name=\"directory links heading\">Directory</h5>\n<ul class=\"flex flex-col gap-4 font-light text-sm\" data-kid=\"1-7-1-2-1-1-2\" data-name=\"directory links list\">\n<li data-kid=\"1-7-1-2-1-1-2-1\" data-name=\"directory item 01\">Properties</li>\n<li data-kid=\"1-7-1-2-1-1-2-2\" data-name=\"directory item 02\">Localities</li>\n<li data-kid=\"1-7-1-2-1-1-2-3\" data-name=\"directory item 03\">Calculators</li>\n<li data-kid=\"1-7-1-2-1-1-2-4\" data-name=\"directory item 04\">Resources</li>\n</ul>\n</div>\n<div data-kid=\"1-7-1-2-1-2\" data-name=\"connect column\">\n<h5 class=\"font-mono text-xs uppercase tracking-widest text-gray-500 mb-6\" data-kid=\"1-7-1-2-1-2-1\" data-name=\"connect links heading\">Connect</h5>\n<ul class=\"flex flex-col gap-4 font-light text-sm\" data-kid=\"1-7-1-2-1-2-2\" data-name=\"connect links list\">\n<li data-kid=\"1-7-1-2-1-2-2-1\" data-name=\"connect item 01\">info@360ghar.com</li>\n<li data-kid=\"1-7-1-2-1-2-2-2\" data-name=\"connect item 02\">LinkedIn</li>\n<li data-kid=\"1-7-1-2-1-2-2-3\" data-name=\"connect item 03\">Instagram</li>\n<li data-kid=\"1-7-1-2-1-2-2-4\" data-name=\"connect item 04\">App Store</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n<div class=\"flex justify-between items-center opacity-30\" data-kid=\"1-7-2\" data-name=\"footer bottom bar\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-7-2-1\" data-name=\"copyright container\">\n<span class=\"text-xs font-mono uppercase tracking-widest\" data-kid=\"1-7-2-1-1\" data-name=\"copyright notice text\">© 2026 360Ghar</span>\n</div>\n<div class=\"font-mono text-xs uppercase tracking-widest\" data-kid=\"1-7-2-2\" data-name=\"location tagline text\">Gurugram — VR-First Real Estate</div>\n</div>\n</footer>\n</div>",
